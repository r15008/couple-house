{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-house",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
